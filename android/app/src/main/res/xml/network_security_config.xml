<?xml version="1.0" encoding="utf-8"?>
<!-- Phones connect only over the internet with https (Share online link or the hosted service):
     the phone's normal trusted certificates, no plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
