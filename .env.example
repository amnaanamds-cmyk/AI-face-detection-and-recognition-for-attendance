# Copy to .env and adjust. All values are optional.
# SECRET_KEY=change-me-to-a-long-random-string      # signs login cookies + derives the embedding encryption key
# EMBEDDING_KEY=                                     # separate key for encrypting face embeddings (optional)
# DATABASE_URL=sqlite:///data/attendance.db          # or postgresql+psycopg://user:pass@host/db
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123                            # only used to create the first admin - change it after login!

# AI settings
# VISION_BACKEND=opencv          # opencv (YuNet + SFace) | fake (tests only)
# MODELS_DIR=models
# DETECTION_SCORE=0.85
# MIN_FACE_SIZE=40
# MATCH_THRESHOLD=0.45           # cosine similarity; tune with scripts/evaluate.py
# MATCH_MARGIN=0.05
# VOTES_REQUIRED=3

# Liveness
# LIVENESS_ENABLED=true
# LIVENESS_MODE=auto            # auto | cnn | motion | cnn+motion
# ANTISPOOF_THRESHOLD=0.7
# LIVENESS_MIN_FRAMES=6
# LIVENESS_MOTION_THRESHOLD=0.12
# LIVENESS_TIMEOUT=12
# LIVENESS_MIN_SHARPNESS=15

# Optional e-mail alerts
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER=attendance@example.edu
