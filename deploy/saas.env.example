# Copy to saas.env and fill in. Never commit saas.env.
DOMAIN=attend.example.com
DB_PASSWORD=
# generate each secret with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# separate key for encrypting face templates (keep a backup: without it templates cannot be read)
EMBEDDING_KEY=
ADMIN_USERNAME=operator
ADMIN_PASSWORD=

APP_NAME=FaceAttend
SUPPORT_EMAIL=support@example.com

# Legal pages (/legal/*)
LEGAL_COMPANY_NAME=Your Company Ltd
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_ADDRESS=Street, City, Country
LEGAL_COUNTRY=Country

# Stripe (Dashboard > Developers). Create three recurring prices and paste their ids.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# E-mail alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
